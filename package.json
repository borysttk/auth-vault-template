{
  "name": "@mcp/auth-vault",
  "version": "0.2.0",
  "description": "MCP server for secure credential management, browser-based login automation, and captcha detection/solving",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-auth-vault": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "add-creds": "tsx src/cli/add-credentials.ts",
    "add-secret": "tsx src/cli/add-secret.ts",
    "list-creds": "node dist/cli/list-credentials.js",
    "get-creds": "node dist/cli/get-credential.js",
    "list-secrets": "node dist/cli/list-secrets.js",
    "add-ssh-key": "tsx src/cli/add-ssh-key.ts",
    "list-ssh-keys": "node dist/cli/list-ssh-keys.js",
    "get-ssh-key": "node dist/cli/get-ssh-key.js",
    "generate-ssh-key": "tsx src/cli/generate-ssh-key.ts",
    "web": "node dist/web/server.js",
    "web-dev": "tsx src/web/server.ts",
    "postinstall": "npx playwright install chromium --with-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "dotenv": "^16.4.0",
    "playwright": "^1.52.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "auth",
    "credentials",
    "captcha",
    "browser-automation",
    "login"
  ],
  "license": "MIT"
}
